# KChat Drive — single-VM-pool deployment environment.
# Copy to .env and fill in the values. Never commit the real .env.

# --- TLS / routing ---
KDRIVE_HOST=drive.example.com
LETSENCRYPT_EMAIL=ops@example.com

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=kdrive

# --- Storage backend (S3-compatible: Wasabi, AWS S3, or Backblaze B2) ---
# Provider selects the capability/guardrail profile: "wasabi", "s3", or "b2".
STORAGE_PROVIDER=wasabi
STORAGE_ENDPOINT=s3.ap-southeast-1.wasabisys.com
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=kchat-drive-prod
STORAGE_ACCESS_KEY=change-me
STORAGE_SECRET_KEY=change-me
# Backwards compat: these old names are still read by backup.sh.
# WASABI_ENDPOINT, WASABI_REGION, WASABI_BUCKET, WASABI_ACCESS_KEY,
# WASABI_SECRET_KEY are migrated to STORAGE_* automatically by the
# config loader if STORAGE_* is not set.

# --- Cache sizing ---
# Default 400 GiB per replica (plan §3).
KDRIVE_CACHE_MAX_BYTES=429496729600

# --- Backup ---
KDRIVE_BACKUP_CRON=17 3 * * *
KDRIVE_BACKUP_RETENTION_DAYS=14

# --- Worker tuning (P2-10) ---
# Promotion sweep interval (ms). Default 30000 (30s).
KDRIVE_PROMOTE_INTERVAL_MS=30000
# Max blobs per promotion sweep. Default 100.
KDRIVE_PROMOTE_BATCH_SIZE=100
# Concurrent promote workers. Default 4.
KDRIVE_PROMOTE_PARALLELISM=4
# Repair scan interval (ms). Default 300000 (5min).
KDRIVE_REPAIR_INTERVAL_MS=300000
# Durable blobs to sample per repair scan. Default 10.
KDRIVE_REPAIR_SAMPLE_COUNT=10
# CACHED blob count above which the guardrail job emits a warning.
KDRIVE_QUEUE_DEPTH_ALERT=1000

# --- Circuit breaker (P2-7) ---
# Enable storage backend circuit breaker (fail-fast when backend is down).
KDRIVE_CIRCUIT_BREAKER_ENABLED=false
# Consecutive failures before the breaker opens. Default 10.
KDRIVE_CIRCUIT_BREAKER_THRESHOLD=10
